# StudySync AI - Root Environment Variables Example
# (Optional overrides for backend configuration)

# Server port (defaults to 8001 locally, set dynamically by Render in production)
PORT=8001

# Allowed origins for CORS (comma-separated list of URLs)
# Example for production:
FRONTEND_URL=https://your-studysync-frontend.vercel.app

# Optional SQLite database path or SQLAlchemy database URL
# Defaults to backend/studysync.db
DATABASE_URL=sqlite:///backend/studysync.db
