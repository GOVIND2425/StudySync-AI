# StudySync AI - Frontend Environment Variables Example

# For local development with Vite proxy:
# Leave blank or set to:
# VITE_API_BASE_URL=http://127.0.0.1:8001

# For production deployment on Vercel:
# Set to your deployed Render backend URL (without trailing slash):
VITE_API_BASE_URL=https://studysync-ai-backend.onrender.com
